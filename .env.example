# Copy to .env (never committed) to build ByTune with accounts, sync and Rooms.
# scripts/build-main.mjs bakes these into the app. Without them a build runs
# guest-only; a release build (npm run dist*) refuses to.
#
# Building your own copy? Point these at your own Supabase project
# (Supabase -> Project Settings -> API Keys: the URL and the publishable key).
BYTUNE_SUPABASE_URL=
BYTUNE_SUPABASE_KEY=
